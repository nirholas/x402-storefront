# ——— Required ———

# EVM address that receives USDC payments (merchant wallet).
PAY_TO_ADDRESS=0xYourWalletAddress

# ——— Payment network (defaults are testnet) ———

# base-sepolia (testnet, default) or base (mainnet).
#NETWORK=base-sepolia

# x402 facilitator that verifies + settles payments.
# Default: https://x402.org/facilitator (testnet). For mainnet use a
# mainnet-capable facilitator, e.g. Coinbase's CDP facilitator.
#FACILITATOR_URL=https://x402.org/facilitator

# ——— Signing ———

# Secret for HMAC-SHA256 artifact signatures and download tokens.
# A dev default is used if unset — ALWAYS set your own in production.
#SIGNING_SECRET=change-me-to-a-long-random-string

# ——— Tuning ———

# HTTP port (default 4021).
#PORT=4021

# How long signed download URLs stay valid, in seconds (default 3600).
#DOWNLOAD_TTL_SECONDS=3600
